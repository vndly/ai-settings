{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "internetAccessPolicy": "allow",
  "model": "Gemini 3.7 Flash (High)",
  "notifications": true,
  "statusLine": {
    "enabled": true,
    "command": "~/.gemini/config/scripts/statusline.sh",
    "stack_with_default": false
  },
  "toolExecutionPolicy": "always-proceed",
  "permissions": {
    "allow": [
      "read_url(docs.anthropic.com)",
      "read_url(antigravity.google)",
      "read_url(github.com)",
      "read_url(raw.githubusercontent.com)",
      "read_url(pypi.org)",
      "read_url(npmjs.com)",
      "read_url(crates.io)",
      "read_url(localhost)",
      "execute_url(localhost)",
      "command(python3)",
      "command(git)",
      "command(rm)",
      "command(chmod)",
      "command(agy)",
      "command(which)",
      "command(strings)",
      "command(grep)",
      "command(sort)",
      "command(head)",
      "command(nm)",
      "command(jq)",
      "command(printf)",
      "command(ls)",
      "command(bash)",
      "command(echo)",
      "command(cat)",
      "command(find)",
      "command(sed)",
      "command(awk)",
      "command(cut)",
      "command(wc)",
      "command(tr)",
      "command(mkdir)",
      "command(cp)",
      "command(mv)",
      "command(touch)",
      "command(curl)",
      "command(diff)",
      "command(rg)",
      "command(fd)",
      "command(tree)",
      "command(gh)",
      "command(make)",
      "command(docker)",
      "command(node)",
      "command(npm)",
      "command(npx)",
      "command(pnpm)",
      "command(yarn)",
      "command(pip)",
      "command(pip3)",
      "command(pytest)",
      "command(uv)",
      "command(cargo)",
      "command(go)"
    ]
  }
}