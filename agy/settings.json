{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "internetAccessPolicy": "allow",
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "statusLine": {
    "enabled": true,
    "command": "~/.gemini/config/scripts/statusline.sh"
  },
  "toolExecutionPolicy": "always-proceed",
  "permissions": {
    "allow": [
      "read_url(*)",
      "execute_url(*)",
      "command(*)",
      "read_file(*)",
      "write_file(*)",
      "mcp(*)"
    ]
  }
}